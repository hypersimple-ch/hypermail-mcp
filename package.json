{
  "name": "hypermail-mcp",
  "version": "0.7.29",
  "description": "Open-source MCP server for AI agents to manage Gmail, Outlook, Microsoft 365, and IMAP mailboxes through one unified interface.",
  "type": "module",
  "bin": {
    "hypermail-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:http": "tsup && node dist/cli.js --http",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "ai-agents",
    "gmail",
    "google-workspace",
    "outlook",
    "microsoft-365",
    "microsoft-graph",
    "imap",
    "smtp"
  ],
  "license": "MIT",
  "homepage": "https://hypermail.hypersimple.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypersimple-ch/hypermail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/hypersimple-ch/hypermail-mcp/issues"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "google-auth-library": "^10.5.0",
    "googleapis": "^173.0.0",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.14",
    "marked": "^18.0.4",
    "nodemailer": "^8.0.8",
    "parse5": "^7.3.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
